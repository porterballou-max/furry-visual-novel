[sub_resource type="Resource" id="Resource_dlpu8"]
script = ExtResource("2_hqvub")
text = "That cannot be true. This is the Historical Dormitorium, one of the oldest buildings still standing on campus."
speaker = &"Rex"
heart_slide_value = 4
type_sound = ExtResource("3_hqvub")
auto = true
metadata/_custom_type_script = "uid://c3bm6y7ffnn77"

[sub_resource type="Resource" id="Resource_35igj"]
script = ExtResource("2_hqvub")
text = "As a student of architecture, I leaped at the chance to live within these walls. These bricks were laid by men who lived generations before us."
character_animation_name = &"front_profile_lookaway"
auto = true
metadata/_custom_type_script = "uid://c3bm6y7ffnn77"

[sub_resource type="Resource" id="Resource_02rlc"]
script = ExtResource("2_hqvub")
text = "Besides, it would be highly reckless for a carnivore not to double check the building he's entering."
character_animation_name = &"front_profile_eye_closed"
auto = true
metadata/_custom_type_script = "uid://c3bm6y7ffnn77"

[sub_resource type="Resource" id="Resource_qv7yq"]
script = ExtResource("2_hqvub")
text = "If I entered an herbivores-only establishment, well..."
character_animation_name = &"front_profile_lookaway_2"
auto = true
metadata/_custom_type_script = "uid://c3bm6y7ffnn77"

[sub_resource type="Resource" id="Resource_hqvub"]
script = ExtResource("2_hqvub")
text = "I believe my stay here would be quite brief."
character_animation_name = &"front_profile"
heart_slide_value = 7
auto = true
metadata/_custom_type_script = "uid://c3bm6y7ffnn77"

