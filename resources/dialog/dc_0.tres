[sub_resource type="Resource" id="Resource_nqhml"]
script = ExtResource("1_yyy1i")
text = "My name is Sky and I am a rabbit beginning to attend university."
speaker = &"Sky"
script_on_complete = SubResource("Resource_n6hdu")
type_sound = ExtResource("5_qshk4")
metadata/_custom_type_script = "uid://c3bm6y7ffnn77"

[sub_resource type="Resource" id="Resource_km5ld"]
script = ExtResource("1_yyy1i")
text = "I am very scared of carnivores--wolves, bears, snakes, etcetera.."
metadata/_custom_type_script = "uid://c3bm6y7ffnn77"

[sub_resource type="Resource" id="Resource_i2t4f"]
script = ExtResource("1_yyy1i")
text = "Mercifully, I was able to find a prey-only dormitorium... well, barely."
metadata/_custom_type_script = "uid://c3bm6y7ffnn77"

[sub_resource type="Resource" id="Resource_aicyk"]
script = ExtResource("1_yyy1i")
text = "The last public documentation I could find was from some decades ago."
metadata/_custom_type_script = "uid://c3bm6y7ffnn77"

[sub_resource type="Resource" id="Resource_q7n7w"]
script = ExtResource("1_yyy1i")
text = "Nevertheless, I'm glad to have found a place where my heart won't start racing. Now before the door of my room, I twist the knob..."
script_on_complete = ExtResource("5_nqhml")
metadata/_custom_type_script = "uid://c3bm6y7ffnn77"

